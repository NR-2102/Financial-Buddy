# ==============================================================
# AZURE AI FOUNDRY AGENT INTEGRATION CONFIGURATION
# ==============================================================

# 1. Azure AI Project Endpoint
# Found in: Azure AI Foundry Portal (ai.azure.com) -> Project Settings -> Overview / Endpoints
AZURE_AI_PROJECT_ENDPOINT=https://MoneyArnold-01.services.ai.azure.com/api/projects/MoneyArnold-01

# 2. Azure AI Project API Key (Required for live authentication)
# Found in: Azure AI Foundry Portal -> Project Settings -> Keys and Credentials (or Azure Portal)
AZURE_AI_PROJECT_KEY=

# 3. Agent Identification
# Option A: Single Agent or 4th Summarizer Agent (Recommended for direct GPT-style AI Assistant)
# Found in: Azure AI Foundry Portal -> Build -> Agents (starts with 'asst_...')
AZURE_AI_AGENT_ID=

# Option B: Sequential 4-Agent Pipeline (if you deployed all 4 separately)
AGENT_ANALYZER_ID=
AGENT_PLANNER_ID=
AGENT_ACTION_ID=
AGENT_SUMMARIZER_ID=

# Option C: Workflow Agent ID
FOUNDRY_WORKFLOW_ID=

# 4. Fallback Mode
# Set to 'false' to communicate with Azure AI Foundry live.
# Set to 'true' to use local mock simulation if offline or testing.
USE_MOCK_FALLBACK=false
